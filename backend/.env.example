# ── BidSentinel backend ───────────────────────────────────────
# Copy to backend/.env for local development.
# On Render/Vercel set these as Environment Variables instead.

APP_ENV=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Seed the demo tender/bidders/users on boot when the DB is empty.
AUTO_SEED=true

# ── Database ──────────────────────────────────────────────────
# Local (default): SQLite file next to the backend.
DATABASE_URL=sqlite+aiosqlite:///./bidsentinel.db
SYNC_DATABASE_URL=sqlite:///./bidsentinel.db

# Production (Neon / Supabase / Render Postgres) — keep the asyncpg driver:
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
#   SYNC_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ── Redis (optional; batch verification falls back to sync) ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object storage (optional) ─────────────────────────────────
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bidsentinel

# ── Connectors and AI ─────────────────────────────────────────
# "mock" keeps every portal response deterministic and offline.
CONNECTOR_MODE=mock
AI_PROVIDER=mock
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" only for local development — browsers reject wildcard
# origins on credentialed requests.
ALLOWED_ORIGINS=*
